{
	"name": "my-editor",
	"main": "src/worker.js",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "../frontend/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"vars": {
		"NODE_ENV": "production"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "41c48bea407e4db28eb93a670ac6f0e2"
		}
	]
}